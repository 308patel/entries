<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>No × 108 Ledger</title>
  <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@300;400;600;700&family=IBM+Plex+Sans:wght@300;400;600&display=swap" rel="stylesheet" />
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --bg:        #0a0a0f;
      --surface:   #111118;
      --border:    #2a2a3a;
      --accent:    #f0c040;
      --accent2:   #40c0f0;
      --danger:    #f05050;
      --text:      #e8e8f0;
      --muted:     #6060788;
      --mono:      'IBM Plex Mono', monospace;
      --sans:      'IBM Plex Sans', sans-serif;
    }

    body {
      background: var(--bg);
      color: var(--text);
      font-family: var(--sans);
      min-height: 100vh;
      padding: 2rem 1rem;
    }

    /* Subtle grid background */
    body::before {
      content: '';
      position: fixed;
      inset: 0;
      background-image:
        linear-gradient(rgba(240,192,64,0.03) 1px, transparent 1px),
        linear-gradient(90deg, rgba(240,192,64,0.03) 1px, transparent 1px);
      background-size: 40px 40px;
      pointer-events: none;
      z-index: 0;
    }

    .container {
      max-width: 820px;
      margin: 0 auto;
      position: relative;
      z-index: 1;
    }

    /* ─── HEADER ─── */
    header {
      display: flex;
      align-items: baseline;
      gap: 1rem;
      margin-bottom: 2.5rem;
      border-bottom: 1px solid var(--border);
      padding-bottom: 1.5rem;
    }

    header h1 {
      font-family: var(--mono);
      font-size: 1.6rem;
      font-weight: 700;
      letter-spacing: -0.02em;
      color: var(--accent);
    }

    header .subtitle {
      font-family: var(--mono);
      font-size: 0.75rem;
      color: #666;
      letter-spacing: 0.1em;
    }

    /* ─── ALERT MESSAGES ─── */
    .alert {
      padding: 0.75rem 1rem;
      border-left: 3px solid;
      font-family: var(--mono);
      font-size: 0.82rem;
      margin-bottom: 1.5rem;
      border-radius: 0 4px 4px 0;
    }
    .alert.error   { border-color: var(--danger); background: rgba(240,80,80,0.08); color: var(--danger); }
    .alert.success { border-color: var(--accent2); background: rgba(64,192,240,0.08); color: var(--accent2); }

    /* ─── ADD ENTRY CARD ─── */
    .add-card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 8px;
      padding: 1.5rem;
      margin-bottom: 2rem;
    }

    .add-card h2 {
      font-family: var(--mono);
      font-size: 0.7rem;
      letter-spacing: 0.18em;
      color: #666;
      text-transform: uppercase;
      margin-bottom: 1.2rem;
    }

    .input-row {
      display: flex;
      gap: 0.75rem;
      align-items: flex-end;
      flex-wrap: wrap;
    }

    .field-group {
      display: flex;
      flex-direction: column;
      gap: 0.4rem;
    }

    .field-group label {
      font-family: var(--mono);
      font-size: 0.72rem;
      color: #888;
      letter-spacing: 0.1em;
    }

    .field-group input {
      background: var(--bg);
      border: 1px solid var(--border);
      color: var(--text);
      font-family: var(--mono);
      font-size: 1rem;
      padding: 0.6rem 0.9rem;
      border-radius: 4px;
      width: 160px;
      outline: none;
      transition: border-color 0.2s;
    }

    .field-group input:focus {
      border-color: var(--accent);
    }

    .preview {
      background: var(--bg);
      border: 1px solid var(--border);
      border-radius: 4px;
      padding: 0.6rem 0.9rem;
      font-family: var(--mono);
      font-size: 1rem;
      color: var(--accent);
      min-width: 160px;
      border-style: dashed;
    }

    .preview span {
      font-size: 0.7rem;
      color: #666;
      display: block;
      margin-bottom: 0.2rem;
      letter-spacing: 0.1em;
    }

    .btn {
      padding: 0.65rem 1.4rem;
      font-family: var(--mono);
      font-size: 0.85rem;
      font-weight: 600;
      border: none;
      border-radius: 4px;
      cursor: pointer;
      letter-spacing: 0.05em;
      transition: all 0.18s;
    }

    .btn-primary {
      background: var(--accent);
      color: #0a0a0f;
    }
    .btn-primary:hover { background: #f8d060; transform: translateY(-1px); }

    .btn-danger {
      background: transparent;
      color: var(--danger);
      border: 1px solid rgba(240,80,80,0.35);
      padding: 0.35rem 0.8rem;
      font-size: 0.75rem;
    }
    .btn-danger:hover { background: rgba(240,80,80,0.12); }

    .btn-ghost {
      background: transparent;
      color: #666;
      border: 1px solid var(--border);
    }
    .btn-ghost:hover { color: var(--danger); border-color: var(--danger); }

    /* ─── TABLE ─── */
    .table-card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 8px;
      overflow: hidden;
      margin-bottom: 1.5rem;
    }

    .table-header-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 1rem 1.5rem;
      border-bottom: 1px solid var(--border);
    }

    .table-header-row h2 {
      font-family: var(--mono);
      font-size: 0.7rem;
      letter-spacing: 0.18em;
      color: #666;
      text-transform: uppercase;
    }

    table {
      width: 100%;
      border-collapse: collapse;
    }

    thead th {
      font-family: var(--mono);
      font-size: 0.68rem;
      letter-spacing: 0.15em;
      text-transform: uppercase;
      color: #555;
      padding: 0.75rem 1.5rem;
      text-align: left;
      border-bottom: 1px solid var(--border);
    }

    tbody tr {
      border-bottom: 1px solid rgba(42,42,58,0.5);
      transition: background 0.15s;
    }
    tbody tr:last-child { border-bottom: none; }
    tbody tr:hover { background: rgba(255,255,255,0.02); }

    tbody td {
      padding: 0.85rem 1.5rem;
      font-family: var(--mono);
      font-size: 0.92rem;
    }

    .td-no    { color: var(--accent2); font-weight: 600; }
    .td-total { color: var(--accent);  font-weight: 600; }
    .td-multi { color: #555; font-size: 0.75rem; }

    .td-action { text-align: right; }

    /* ─── EMPTY STATE ─── */
    .empty {
      text-align: center;
      padding: 3rem;
      font-family: var(--mono);
      color: #444;
    }
    .empty .big { font-size: 2.5rem; margin-bottom: 0.5rem; }
    .empty p { font-size: 0.8rem; letter-spacing: 0.1em; }

    /* ─── GRAND TOTAL ─── */
    .grand-total-card {
      background: linear-gradient(135deg, rgba(240,192,64,0.12), rgba(240,192,64,0.04));
      border: 1px solid rgba(240,192,64,0.3);
      border-radius: 8px;
      padding: 1.2rem 1.5rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .grand-total-card .label {
      font-family: var(--mono);
      font-size: 0.7rem;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: #888;
    }

    .grand-total-card .value {
      font-family: var(--mono);
      font-size: 2rem;
      font-weight: 700;
      color: var(--accent);
      letter-spacing: -0.02em;
    }

    .grand-total-card .formula {
      font-family: var(--mono);
      font-size: 0.7rem;
      color: #555;
      margin-top: 0.2rem;
    }

    /* ─── STATS ROW ─── */
    .stats-row {
      display: flex;
      gap: 1rem;
      margin-bottom: 1.5rem;
    }

    .stat-box {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 6px;
      padding: 0.9rem 1.2rem;
      flex: 1;
    }

    .stat-box .s-label {
      font-family: var(--mono);
      font-size: 0.65rem;
      letter-spacing: 0.15em;
      color: #555;
      text-transform: uppercase;
      margin-bottom: 0.3rem;
    }

    .stat-box .s-value {
      font-family: var(--mono);
      font-size: 1.2rem;
      font-weight: 600;
      color: var(--text);
    }

    /* ─── FOOTER ─── */
    footer {
      margin-top: 2.5rem;
      text-align: center;
      font-family: var(--mono);
      font-size: 0.7rem;
      color: #333;
      letter-spacing: 0.1em;
    }

    /* animations */
    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(8px); }
      to   { opacity: 1; transform: translateY(0); }
    }
    .container > * {
      animation: fadeIn 0.4s ease both;
    }
    .container > *:nth-child(1) { animation-delay: 0.05s; }
    .container > *:nth-child(2) { animation-delay: 0.10s; }
    .container > *:nth-child(3) { animation-delay: 0.15s; }
    .container > *:nth-child(4) { animation-delay: 0.20s; }
    .container > *:nth-child(5) { animation-delay: 0.25s; }

    @media (max-width: 600px) {
      .input-row { flex-direction: column; }
      .stats-row { flex-direction: column; }
      .field-group input, .preview { width: 100%; }
      table thead { display: none; }
      tbody td { display: block; padding: 0.4rem 1rem; }
      tbody tr { padding: 0.75rem 0; }
    }
  </style>
</head>
<body>
  <div class="container">

    <!-- HEADER -->
    <header>
      <h1>⬡ NO × 108 LEDGER</h1>
      <span class="subtitle">MongoDB · Express · EJS</span>
    </header>

    <!-- ALERTS -->
    <% if (error) { %>
      <div class="alert error">⚠ <%= error %></div>
    <% } %>
    <% if (success) { %>
      <div class="alert success">✓ <%= success %></div>
    <% } %>

    <!-- ADD ENTRY -->
    <div class="add-card">
      <h2>// Add New Entry</h2>
      <form action="/add" method="POST">
        <div class="input-row">
          <div class="field-group">
            <label>NO</label>
            <input
              type="number"
              name="no"
              id="noInput"
              placeholder="e.g. 5"
              min="1"
              required
              oninput="updatePreview(this.value)"
            />
          </div>
          <div class="field-group">
            <label>TOTAL (auto)</label>
            <div class="preview">
              <span>no × 108 =</span>
              <span id="previewVal">—</span>
            </div>
          </div>
          <button type="submit" class="btn btn-primary">+ ADD ENTRY</button>
        </div>
      </form>
    </div>

    <!-- STATS -->
    <div class="stats-row">
      <div class="stat-box">
        <div class="s-label">Total Entries</div>
        <div class="s-value"><%= entries.length %></div>
      </div>
      <div class="stat-box">
        <div class="s-label">Sum of NO values</div>
        <div class="s-value"><%= entries.reduce((s, e) => s + e.no, 0) %></div>
      </div>
      <div class="stat-box">
        <div class="s-label">Multiplier</div>
        <div class="s-value">× 108</div>
      </div>
    </div>

    <!-- TABLE -->
    <div class="table-card">
      <div class="table-header-row">
        <h2>// Entries</h2>
        <% if (entries.length > 0) { %>
          <form action="/clear" method="POST"
                onsubmit="return confirm('Clear all entries?')">
            <button type="submit" class="btn btn-ghost">✕ CLEAR ALL</button>
          </form>
        <% } %>
      </div>

      <% if (entries.length === 0) { %>
        <div class="empty">
          <div class="big">∅</div>
          <p>NO ENTRIES YET — ADD ONE ABOVE</p>
        </div>
      <% } else { %>
        <table>
          <thead>
            <tr>
              <th>#</th>
              <th>NO</th>
              <th>FORMULA</th>
              <th>TOTAL</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            <% entries.forEach((entry, i) => { %>
              <tr>
                <td style="color:#444; font-size:0.75rem;"><%= entries.length - i %></td>
                <td class="td-no"><%= entry.no %></td>
                <td class="td-multi"><%= entry.no %> × 108</td>
                <td class="td-total"><%= entry.total.toLocaleString() %></td>
                <td class="td-action">
                  <form action="/delete/<%= entry._id %>" method="POST"
                        style="display:inline;">
                    <button type="submit" class="btn btn-danger">DEL</button>
                  </form>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } %>
    </div>

    <!-- GRAND TOTAL -->
    <div class="grand-total-card">
      <div>
        <div class="label">Grand Total</div>
        <div class="formula">SUM of all (no × 108)</div>
      </div>
      <div class="value"><%= grandTotal.toLocaleString() %></div>
    </div>

    <footer>
      <p>NO × 108 LEDGER · POWERED BY NODE + EXPRESS + MONGODB</p>
    </footer>
  </div>

  <script>
    function updatePreview(val) {
      const n = parseInt(val);
      const el = document.getElementById('previewVal');
      el.textContent = (!isNaN(n) && n > 0) ? (n * 108).toLocaleString() : '—';
    }
  </script>
</body>
</html>
